# === Voice / audio.cpp (canonical TTS runtime) ===
# Legacy AUDIO_CPP_* kept for compat; prefer MRPLAY_* overrides.
MRPLAY_AUDIO_CPP_ENABLED=true
MRPLAY_AUDIO_CPP_MODE=auto
MRPLAY_AUDIO_CPP_LOCAL_URL=http://127.0.0.1:8080
MRPLAY_AUDIO_CPP_REMOTE_URL=
AUDIO_CPP_REMOTE_TOKEN=your-remote-gpu-auth-token
MRPLAY_AUDIO_CPP_FAMILY=qwen3_tts
MRPLAY_AUDIO_CPP_MODEL=models/Qwen3-TTS-12Hz-1.7B-Base
MRPLAY_AUDIO_CPP_BACKEND=best
MRPLAY_AUDIO_CPP_LANGUAGE=de
MRPLAY_AUDIO_CPP_TIMEOUT_SECS=300
# Legacy aliases
AUDIO_CPP_MODE=auto
AUDIO_CPP_LOCAL_URL=http://127.0.0.1:8080
AUDIO_CPP_REMOTE_URL=https://gpu.example.com
AUDIO_CPP_FAMILY=qwen3_tts
AUDIO_CPP_MODEL=models/Qwen3-TTS-12Hz-1.7B-Base
AUDIO_CPP_BACKEND=best
AUDIO_CPP_LANGUAGE=de

# === GPU policy ===
MRPLAY_GPU_PREFER_FREE=true
MRPLAY_GPU_ALLOW_PAID=false
MRPLAY_GPU_MAX_COST_PER_JOB=0.50
MRPLAY_GPU_MAX_COST_PER_DAY=5.00

# === Voice cloning (audio.cpp-compatible) ===
MRPLAY_VOICE_CLONE_ENABLED=true
MRPLAY_VOICE_CLONE_RUNTIME=audio_cpp
MRPLAY_VOICE_CLONE_FAMILY=qwen3_tts
MRPLAY_VOICE_CLONE_MODEL=models/Qwen3-TTS-12Hz-1.7B-Base
MRPLAY_VOICE_CLONE_LANGUAGE=de
MRPLAY_VOICE_CLONE_ROUTING_MODE=auto

# === Narrator AI ===
MRPLAY_NARRATOR_BACKEND=openai
MRPLAY_NARRATOR_LANGUAGE=en-US
MRPLAY_NARRATOR_STYLE=radio_drama
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=
FREESOUND_API_KEY=

# === TTS Provider: Modal.com (optional fallback) ===
MODAL_TTS_ENDPOINT=https://<your-workspace>--do-movie-radio-play-tts-generate-speech.modal.run
# MODAL_TOKEN_ID=...
# MODAL_TOKEN_SECRET=...

# === Sound Effects Engine ===
SFX_LOCAL_ROOT=./assets/sfx
SFX_AI_MODE=auto
SFX_AI_ENDPOINT=https://sfx-gpu.example.com
SFX_AI_AUTH_TOKEN=your-sfx-auth-token
