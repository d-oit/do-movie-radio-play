{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d-oit.dev/movie-radio-play/timeline.schema.json",
  "title": "TimelineOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "file",
    "analysis_sample_rate",
    "frame_ms",
    "segments"
  ],
  "properties": {
    "file": {
      "type": "string"
    },
    "analysis_sample_rate": {
      "type": "integer",
      "minimum": 1
    },
    "frame_ms": {
      "type": "integer",
      "minimum": 1
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start_ms",
          "end_ms",
          "kind",
          "confidence",
          "tags",
          "prompt"
        ],
        "properties": {
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "end_ms": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "type": "string",
            "enum": [
              "speech",
              "non_voice"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prompt": {
            "type": [
              "string",
              "null"
            ]
          },
          "sfx_trigger": {
            "description": "Optional sound-effect trigger. Serialized by Segment with a serde tag of `type`; emitted as null when absent, and optional on input via #[serde(default)].",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "none"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "tags"
                ],
                "properties": {
                  "type": {
                    "const": "auto_select"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "mood": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "sfx_id"
                ],
                "properties": {
                  "type": {
                    "const": "specific"
                  },
                  "sfx_id": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "prompt",
                  "duration_secs"
                ],
                "properties": {
                  "type": {
                    "const": "ai_generate"
                  },
                  "prompt": {
                    "type": "string"
                  },
                  "duration_secs": {
                    "type": "number"
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
